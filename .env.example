# Copy this file to .env for local development.
# Set these as Environment Variables in Netlify → Site configuration → Environment variables.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
ADMIN_PATH=

# Shared doctor sign-in passcode, checked server-side by netlify/functions/adminLogin.mts.
ADMIN_PASSCODE=

# Only required in production (Netlify dashboard) — netlify dev talks to the
# local Firestore/Auth emulators instead and doesn't need this. Paste the raw
# JSON from Firebase console → Project settings → Service accounts →
# Generate new private key, as a single line.
FIREBASE_SERVICE_ACCOUNT_KEY=
